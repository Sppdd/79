# Copy to .env (or .env.local) and fill in. Every key is optional; without keys the app runs in demo mode.

# ── Nebius Token Factory (Nemotron) ─────────────────────────────
NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Override model IDs if your catalog differs (npm run models lists them):
# NEMOTRON_NANO_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
# NEMOTRON_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# VISION_MODEL=google/gemma-3-27b-it   (describes frames; Nemotron judges them)

# ── Media generation (fal.ai) ───────────────────────────────────
# Without a key, placeholder stills are used (MEDIA_PROVIDER=mock).
FAL_KEY=
# FAL_VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video
# FAL_IMAGE_PRODUCT_MODEL=fal-ai/flux-pro/v1.1

# ── Research (Tavily, optional) ─────────────────────────────────
TAVILY_API_KEY=

# ── Storage ─────────────────────────────────────────────────────
# Neon Postgres. Leave empty locally to use embedded PGlite in .data/
DATABASE_URL=
# Vercel Blob (needed for rendering)
BLOB_READ_WRITE_TOKEN=

# ── Rendering on Nebius Serverless Jobs (optional locally) ──────
NEBIUS_IAM_TOKEN=
NEBIUS_PROJECT_ID=
NEBIUS_JOB_IMAGE=
# NEBIUS_JOB_PLATFORM=cpu-d3
# NEBIUS_JOB_PRESET=4vcpu-16gb
# NEBIUS_SUBNET_ID=
RENDER_CALLBACK_SECRET=
# Public URL Nebius calls back to (defaults to the request origin)
# APP_URL=https://your-app.vercel.app

# ── Cost tier for media generation ──────────────────────────────
# draft (default, ~$0.10–0.20/Reel) or pro (~$1.00–1.40/Reel)
# MEDIA_QUALITY=draft

# ── Local rendering (instead of Nebius) ─────────────────────────
# Renders MP4s on this machine with ffmpeg (brew install ffmpeg) into public/renders/.
# RENDER_MODE=local
