# ── Nebius Token Factory (the only paid service) ────────────────
NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Model per job (npm run models lists what your key can use):
# NEMOTRON_FAST_MODEL=nvidia/Nemotron-3_5-Lightning        triage + guardrail checks
# NEMOTRON_NANO_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B  customer memory
# NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b     everyday replies
# NEMOTRON_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b     complaints, haggling, daily summary
# EMBED_MODEL=Qwen/Qwen3-Embedding-8B                        catalog search

# ── WhatsApp Cloud API (leave empty to use the built-in simulator) ─
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-any-string
WHATSAPP_APP_SECRET=

# ── Storage ─────────────────────────────────────────────────────
# Empty = embedded PGlite in .data/ (local dev). docker compose sets this to Postgres.
DATABASE_URL=
# MEDIA_DIR=./public/media

# ── Jobs ────────────────────────────────────────────────────────
CRON_SECRET=local-dev
# SIM_ENABLED=1   # allow the simulator in production (demo only)

# ── Optional ────────────────────────────────────────────────────
TAVILY_API_KEY=
